# Copier ce fichier vers .env.local et renseigner les valeurs du projet Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Origine de l'application pour les emails de confirmation (URL de production au déploiement).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Clé publique d’une application Web GIPHY pour le sélecteur du chat.
NEXT_PUBLIC_GIPHY_API_KEY=

# Interrompt globalement toutes les routes applicatives avec une page statique 503.
MAINTENANCE_MODE=false

# Import uniquement : clé serveur, jamais préfixée NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Alternative legacy à SUPABASE_SECRET_KEY :
# SUPABASE_SERVICE_ROLE_KEY=
