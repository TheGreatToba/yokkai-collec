# Foundation only: do not enable purchases before the release checklist is complete.
STRIPE_BILLING_ENABLED=false
STRIPE_CHECKOUT_ENABLED=false
STRIPE_BILLING_MODE=test

# Server-only values. Never use NEXT_PUBLIC_ and never commit real credentials.
STRIPE_SECRET_KEY=
STRIPE_ACCOUNT_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_WEBHOOK_SECRET=
STRIPE_RECONCILIATION_SECRET=

# Reuse the existing Supabase server configuration:
# SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY
# NEXT_PUBLIC_SUPABASE_URL
# NEXT_PUBLIC_SITE_URL

# Test mode: NODE_ENV=development and BOTH application/database on loopback.
# Live mode: NODE_ENV=production, HTTPS database and https://yokkai-collec.com.
# Never configure live credentials in a local environment.
